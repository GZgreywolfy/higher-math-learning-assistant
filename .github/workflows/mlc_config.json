{
  "ignorePatterns": [
    {
      "pattern": "^http://localhost",
      "comment": "忽略本地开发链接"
    },
    {
      "pattern": "^#",
      "comment": "忽略页面内锚点链接"
    },
    {
      "pattern": "^.+\\.md(#.+)?$",
      "comment": "忽略项目内 Markdown 文件链接"
